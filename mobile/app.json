{
  "expo": {
    "name": "PublicReport",
    "slug": "public-report",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#1B4332",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1B4332"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.publicreport.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PublicReport needs your location to pinpoint where the issue is occurring.",
        "NSCameraUsageDescription": "PublicReport needs camera access to capture issue photos.",
        "NSPhotoLibraryUsageDescription": "PublicReport needs photo library access to attach images to your report."
      }
    },
    "android": {
      "package": "in.publicreport.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1B4332"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ]
    },
    "web": {},
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow PublicReport to use your location to report issues accurately."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to your photos to attach to issue reports.",
          "cameraPermission": "Allow camera access to capture issue photos."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "API_BASE_URL": "https://api.publicreport.in",
      "privacyPolicyUrl": "https://publicreportsapp.netlify.app",
      "eas": {
        "projectId": "5ae585b6-64e7-4a51-a24b-16f1a197d2b4"
      }
    },
    "owner": "vikram379"
  }
}
