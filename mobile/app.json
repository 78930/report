{
  "expo": {
    "name": "CivicReport",
    "slug": "civic-report",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1B4332"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.civicreport.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CivicReport needs your location to pinpoint where the issue is occurring.",
        "NSCameraUsageDescription": "CivicReport needs camera access to capture issue photos.",
        "NSPhotoLibraryUsageDescription": "CivicReport needs photo library access to attach images to your report."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B4332"
      },
      "package": "in.civicreport.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {},
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow CivicReport to use your location to report issues accurately."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to your photos to attach to issue reports.",
          "cameraPermission": "Allow camera access to capture issue photos."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "API_BASE_URL": "https://api.civicreport.in",
      "eas": {
        "projectId": "484fcea2-342a-40f3-9f64-209552851cd7"
      }
    }
  }
}
